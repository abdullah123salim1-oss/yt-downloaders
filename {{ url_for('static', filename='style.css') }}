* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0f1015;
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 950px;
    background: #1b1c24;
    padding: 30px;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    text-align: center;
}

h1 {
    margin-bottom: 8px;
    color: #ff334b;
}

p {
    color: #9da3af;
    margin-bottom: 25px;
    font-size: 14px;
}

.input-section {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
}

input {
    flex: 1;
    padding: 14px 18px;
    border-radius: 8px;
    border: 1px solid #2e3240;
    background: #252836;
    color: #fff;
    outline: none;
    font-size: 15px;
}

input:focus {
    border-color: #ff334b;
}

button {
    padding: 14px 28px;
    background-color: #ff334b;
    border: none;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s ease-in-out;
}

button:hover {
    background-color: #e0243b;
}

/* 16:9 Aspect Ratio Container */
.player-container {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 */
    border-radius: 10px;
    overflow: hidden;
    background: #000;
}

.player-container iframe,
.player-container video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: contain;
}